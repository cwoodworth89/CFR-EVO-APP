# Local Station Container Stack Settings
DATABASE_URL=postgresql://cfr_user:cfr_password_2026@localhost:5432/cfr_dispatch
LOCAL_API_URL=http://localhost:8000
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Local Ntfy Push Notification Settings
NTFY_SERVER_URL=http://localhost:8080
NTFY_TOPIC_SECRET=AUTO_MONTHLY
NTFY_MASTER_SALT=cfr_master_salt_2026
CHIEF_MASTER_TOPIC=chief-master

# Optional: Cloud Supabase Backup Push (Set ENABLE_SUPABASE_BACKUP=false for 100% LAN-only mode)
ENABLE_SUPABASE_BACKUP=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Speech-to-Text Engine Selection (google / whisper)
STT_ENGINE=whisper

# Optional: Google Maps Geocoding API Key (If ENABLE_GOOGLE_MAPS_FALLBACK=True in config.py)
GOOGLE_API_KEY=your-google-maps-api-key-here

# Optional: Google Cloud Speech-to-Text V2 Application Credentials (If STT_ENGINE="google" in config.py)
GOOGLE_APPLICATION_CREDENTIALS=backend/cfr-dispatch-mapping-69537f853073.json
