# Local Station Container Stack Settings
DATABASE_URL=postgresql://cfr_user:cfr_password_2026@localhost:5432/cfr_dispatch
LOCAL_API_URL=http://localhost:8000
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Speech-to-Text: local faster-whisper only.
# There is no engine selector. Cloud STT is forbidden by CLAUDE.md s1 (offline
# survival + $0 recurring cost), so the only knob is which local model loads.
WHISPER_MODEL=base            # "tiny", "base", "small", or a path to a fine-tuned model

# Log verbosity: 0 muted, 1 standard, 2 verbose, 3 trace
VERBOSITY_LEVEL=1
