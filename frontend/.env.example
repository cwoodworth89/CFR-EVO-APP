# CFR EVO Client: Local API Gateway & Ntfy Push Settings
# Note: Defaults to http://<window.location.hostname>:8000 if VITE_API_URL is omitted.
VITE_API_URL=http://localhost:8000
VITE_NTFY_PORT=8080
VITE_NTFY_TOPIC_SECRET=AUTO_MONTHLY
VITE_DEFAULT_HALL=1

# Google Maps Platform API Key (for Live Street View & Map features)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
